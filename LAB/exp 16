import math

# Function to calculate Free Space Path Loss
def fspl_db(d_km, f_mhz):
    return 32.44 + 20 * math.log10(d_km) + 20 * math.log10(f_mhz)

# Function to calculate Received Power
def rx_power_dbm(pt, gt, gr, d_km, f_mhz):
    loss = fspl_db(d_km, f_mhz)
    return pt + gt + gr - loss

# Input parameters
f = 2400.0       # Frequency in MHz
pt = 20.0        # Transmit power in dBm
gt = 2.0         # Transmitter antenna gain in dBi
gr = 2.0         # Receiver antenna gain in dBi
sens = -90.0     # Receiver sensitivity in dBm

# Display parameters
print("FREE SPACE PATH LOSS AND RECEIVED POWER")
print("---------------------------------------")
print("Frequency:", f, "MHz")
print("Transmit Power:", pt, "dBm")
print("Transmitter Gain:", gt, "dBi")
print("Receiver Gain:", gr, "dBi")
print("Receiver Sensitivity:", sens, "dBm")

# Calculate for different distances
distances = [0.01, 0.05, 0.1, 0.5, 1, 2, 5, 10]

print("\nDistance  FSPL(dB)  Received(dBm)  Received(W)  Link")
print("----------------------------------------------------")

for d in distances:
    loss = fspl_db(d, f)
    pr = rx_power_dbm(pt, gt, gr, d, f)

    watts = 10 ** ((pr - 30) / 10)

    if pr >= sens:
        status = "OK"
    else:
        status = "FAIL"

    print(f"{d:8.2f} {loss:9.2f} {pr:13.2f} "
          f"{watts:12.3e} {status}")

# Calculate maximum communication range
allowed_loss = pt + gt + gr - sens

d_max = 10 ** (
    (allowed_loss - 32.44 - 20 * math.log10(f)) / 20
)

print("\nMaximum Communication Range")
print("----------------------------")
print("Allowed Path Loss:", round(allowed_loss, 2), "dB")
print("Maximum Range:", round(d_max, 2), "km")

# Effect of frequency at 1 km
print("\nFREQUENCY COMPARISON AT 1 KM")
print("----------------------------")

frequencies = [900, 1800, 2400, 3500]

for freq in frequencies:
    loss = fspl_db(1, freq)
    power = rx_power_dbm(pt, gt, gr, 1, freq)

    print(f"{freq:5d} MHz : FSPL = {loss:6.2f} dB, "
          f"Received Power = {power:7.2f} dBm")

# Effect of doubling distance
print("\nEffect of Doubling Distance")
difference = fspl_db(2, f) - fspl_db(1, f)
print("Additional Path Loss:", round(difference, 2), "dB")
