import math

# Function to generate valid cluster sizes
def valid_cluster_sizes(limit=20):
    sizes = set()

    for i in range(5):
        for j in range(5):
            N = i*i + i*j + j*j

            if N > 0:
                sizes.add(N)

    return sorted(sizes)[:limit]


# Function to calculate frequency reuse parameters
def reuse_metrics(N, S=336, M=21, n=4.0):

    # Channels per cell
    k = S // N

    # Co-channel reuse ratio
    q = math.sqrt(3 * N)

    # Signal-to-interference ratio
    si_db = 10 * math.log10((q ** n) / 6)

    # Total system capacity
    capacity = M * k

    return k, capacity, q, si_db


# Main program
S = 336
M = 21
n = 4.0
req = 18.0

print("FREQUENCY REUSE AND S/I CALCULATION")
print("-----------------------------------")

print("Total channels =", S)
print("Number of cells =", M)
print("Path loss exponent =", n)
print("Required S/I =", req, "dB")

print("\n")
print("{:>3} {:>7} {:>9} {:>10} {:>11} {:>12}".format(
    "N", "D/R", "Ch/Cell", "Capacity", "S/I (dB)", "Meets 18 dB"
))

print("-" * 60)

best = None

# Calculate for different cluster sizes
for N in valid_cluster_sizes(10):

    k, C, q, si = reuse_metrics(N, S, M, n)

    if si >= req:
        status = "YES"

        if best is None:
            best = N
    else:
        status = "NO"

    print("{:3d} {:7.2f} {:9d} {:10d} {:11.2f} {:>12}".format(
        N, q, k, C, si, status
    ))

print("-" * 60)

print("\nSmallest cluster size that meets the")
print("S/I requirement: N =", best)

print("\nAMPS Comparison")
print("----------------")
print("AMPS cluster size = 7")
print("Calculated minimum cluster size =", best)

# Compare different S/I requirements
print("\nS/I REQUIREMENT COMPARISON")
print("--------------------------")

for requirement in [18, 12, 9]:

    minimum = None

    for N in valid_cluster_sizes(10):

        k, C, q, si = reuse_metrics(N, S, M, n)

        if si >= requirement:
            minimum = N
            break

    print("Required S/I:", requirement,
          "dB  -> Smallest N:", minimum)

# Compare different path loss exponents
print("\nPATH LOSS EXPONENT COMPARISON")
print("-----------------------------")

for exponent in [3.0, 3.5, 4.0]:

    k, C, q, si = reuse_metrics(7, S, M, exponent)

    print("n =", exponent,
          "| N = 7 | S/I =", round(si, 2), "dB")
