import numpy as np

# Initialize random number generator
rng = np.random.default_rng(3)

# System parameters
U = 5
RB = 50
TTI = 3000

# User distances in meters
dist = np.array([100, 200, 300, 400, 500.0])

# Calculate mean SNR
mean_snr_db = 40 - 35 * np.log10(dist / 100)
mean_snr = 10 ** (mean_snr_db / 10)


# Function to calculate data rate
def rate(snr):
    return np.minimum(np.log2(1 + snr), 6.0) * 180.0


# Function to simulate scheduler
def simulate(sched):

    thr = np.zeros(U)
    avg = np.ones(U)

    for t in range(TTI):

        # Rayleigh fading
        fade = rng.exponential(1.0, (U, RB))

        # Calculate achievable rate
        r = rate(mean_snr[:, None] * fade)

        # Round Robin scheduling
        if sched == "RR":
            owner = (np.arange(RB) + t) % U

        # Maximum C/I scheduling
        elif sched == "MAXCI":
            owner = r.argmax(axis=0)

        # Proportional Fair scheduling
        else:
            owner = (r / avg[:, None]).argmax(axis=0)

        got = np.zeros(U)

        # Allocate resource blocks
        for b in range(RB):
            got[owner[b]] += r[owner[b], b]

        # Update average throughput
        avg = 0.99 * avg + 0.01 * got

        # Accumulate throughput
        thr += got

    return thr / TTI / 1000


# Function to calculate Jain fairness index
def jain(x):
    return x.sum() ** 2 / (len(x) * (x ** 2).sum())


# Main program
print("OFDMA DOWNLINK SCHEDULER SIMULATION")
print("-----------------------------------")

print("Number of users:", U)
print("Number of resource blocks:", RB)
print("Number of TTIs:", TTI)

print("\nUser distances (m):")
print(dist)

print("\nMEAN SNR (dB):")
print(np.round(mean_snr_db, 2))

# Display results
print("\nSCHEDULER PERFORMANCE RESULTS")
print("-----------------------------------------------")

print(
    f"{'Sched':6}"
    + "".join(f"{'UE'+str(i+1):>9}" for i in range(U))
    + f"{'Total':>10}{'Jain':>9}"
)

print("-" * 80)

for s in ("RR", "MAXCI", "PF"):

    x = simulate(s)

    print(
        f"{s:6}"
        + "".join(f"{v:9.2f}" for v in x)
        + f"{x.sum():10.2f}"
        + f"{jain(x):9.3f}"
    )

print("-" * 80)

print("\nOFDMA SIMULATION COMPLETED SUCCESSFULLY")

