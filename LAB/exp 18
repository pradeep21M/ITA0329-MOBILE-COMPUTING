# Experiment 18: Erlang B Formula

# Function to calculate blocking probability
def erlang_b(E, C):
    """Calculate Erlang B blocking probability."""
    b = 1.0

    for m in range(1, C + 1):
        b = (E * b) / (m + E * b)

    return b


# Function to calculate required channels
def channels_needed(E, gos):
    C = 1

    while erlang_b(E, C) > gos:
        C += 1

    return C


# Function to calculate maximum traffic load
def max_load(C, gos, hi=500.0):
    lo = 0.0

    for _ in range(60):
        mid = (lo + hi) / 2

        if erlang_b(mid, C) < gos:
            lo = mid
        else:
            hi = mid

    return lo


