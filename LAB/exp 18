# Offered traffic calculation
users = 2000
calls_per_hour = 1.5
hold_time = 120

E = users * calls_per_hour * hold_time / 3600

print("\nOFFERED TRAFFIC CALCULATION")
print("---------------------------")

print("Number of users:", users)
print("Calls per hour:", calls_per_hour)
print("Average call duration:", hold_time, "seconds")
print("Offered traffic:", round(E, 1), "Erlang")


# Calculate channels for different GOS
print("\nCHANNELS REQUIRED FOR DIFFERENT GOS")
print("-----------------------------------")

for gos in (0.05, 0.02, 0.01):
    C = channels_needed(E, gos)

    print("GOS:", "{:.0%}".format(gos),
          "| Channels needed:", C)


# Maximum load for 20 channels
print("\nMAXIMUM TRAFFIC LOAD")
print("--------------------")

maximum = max_load(20, 0.02)

print("Number of channels: 20")
print("Target GOS: 2%")
print("Maximum traffic load:", round(maximum, 2), "Erlang")


# Trunking efficiency comparison
print("\nTRUNKING EFFICIENCY COMPARISON")
print("------------------------------")

total_load = 20.0

# One group of 30 channels
single_group = erlang_b(total_load, 30)

# Three groups of 10 channels
three_groups = erlang_b(total_load / 3, 10)

print("One group (30 channels):",
      round(single_group, 4))

print("Three groups (10 channels each):",
      round(three_groups, 4))

